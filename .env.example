# Переменные окружения проекта podium-sale-site
#
# Сайт — статический клиент (без собственного backend-сервера), поэтому
# "переменных окружения" в привычном серверном смысле здесь нет: URL и
# публичный анонимный ключ Supabase прописаны прямо в app.js и admin.html
# как константы (это ожидаемо и безопасно для Supabase — границу доступа
# обеспечивает Row Level Security, не секретность анонимного ключа).
#
# НИКОГДА не вписывайте сюда реальные значения service_role ключа,
# паролей или токенов — этот файл коммитится в открытый репозиторий.
#
# Ниже — переменные, которые используются/могли бы использоваться при
# дальнейшей разработке (например, если переносить конфигурацию из
# захардкоженных констант в секреты GitHub Actions, или заводить
# серверную часть).

# --- Supabase ---
# URL проекта Supabase (публичная информация, не секрет)
SUPABASE_URL=https://your-project-ref.supabase.co

# Анонимный публичный ключ Supabase (безопасен для клиента при
# правильно настроенном RLS; не секрет в строгом смысле, но и не нужно
# публиковать его без необходимости вне кода самого сайта)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role ключ Supabase — ПОЛНЫЙ доступ в обход RLS.
# Используется ТОЛЬКО если понадобится серверный/административный
# скрипт за пределами клиентского кода (например, массовый импорт).
# НИКОГДА не использовать в клиентском коде (app.js/admin.html) и
# НИКОГДА не коммитить реальное значение в репозиторий.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- GitHub Actions (.github/workflows/sync-catalog.yml) ---
# Сейчас эти значения прописаны прямо в workflow-файле как есть
# (то же самое, что SUPABASE_URL/SUPABASE_ANON_KEY выше). Если решите
# вынести их в секреты репозитория (Settings → Secrets and variables →
# Actions), используйте те же имена для единообразия:
# SUPABASE_URL=...
# SUPABASE_ANON_KEY=...

# --- Сопутствующие сервисы (используются как сторонние, без ключей в коде) ---
# Форма "Сотрудничество" отправляется через FormSubmit (formsubmit.co) —
# привязка идёт по email-адресу получателя внутри HTML формы, отдельного
# API-ключа/токена FormSubmit не требует.
